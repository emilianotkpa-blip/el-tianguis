# Copia este archivo como .env y llena los valores.
# .env está en .gitignore: nunca se sube al repositorio.

# ── NocoDB ────────────────────────────────────────────
NOCO_URL=
NOCO_TOKEN=

# ── Tablas de la base "Tianguis" ──────────────────────
NOCO_TABLE_PRODUCTOS=
NOCO_TABLE_STOCK=
NOCO_TABLE_MOVIMIENTOS=
NOCO_TABLE_VENTAS=
NOCO_TABLE_PEDIDOS_CLIENTES=
NOCO_TABLE_PEDIDOS_MERCANCIA=
NOCO_TABLE_CLIENTES=
NOCO_TABLE_EQUIPO=

# Reglas de precio (combos y proporciones).
# Es opcional: sin esta variable el sistema funciona igual, solo que sin
# reglas y la pantalla "Reglas de precio" avisa que falta configurarla.
# La tabla necesita las columnas: Nombre, Tipo, Config_JSON, Activo, Prioridad.
NOCO_TABLE_PROMOS=
# Opcionales: si no se definen, el servidor usa las tablas que ya existen en la base Tianguis
NOCO_TABLE_PROVEEDORES=
NOCO_TABLE_DEPOSITOS=

# ── Otros ─────────────────────────────────────────────
OPENAI_API_KEY=
PORT=3001

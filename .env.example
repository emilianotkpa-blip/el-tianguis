# Variables del servidor de El Tianguis.
# Copia este archivo como .env (o pégalas en el panel del servicio donde lo
# despliegues). .env está en .gitignore: nunca se sube al repositorio.
#
# El servidor arranca aunque falten casi todas y te dice en el log cuáles son:
#
#   NocoDB:   OK | FALTA NOCO_URL
#   Supabase: OK | sin configurar — login viejo y SIN candados de rol
#   OpenAI:   OK | sin llave — solo falla Tianguis IA
#
# El panel y la API se sirven desde el MISMO origen (el front llama a rutas
# /api relativas), así que no hay ninguna variable con la URL pública: el
# servicio sirve el `dist` y la API juntos, como hace el Dockerfile.


# ══ Imprescindibles ══════════════════════════════════════
# Sin esto no hay catálogo, ni ventas, ni inventario.

NOCO_URL=
NOCO_TOKEN=

# Llave con la que se firma la sesión. OJO: si se deja vacía, el código usa
# "dev-insecure-token", que está publicado en este repositorio y sirve para
# entrar. Pon una cadena larga y al azar, distinta en cada servidor.
SESSION_TOKEN=


# ══ Tablas de la base "Tianguis" en NocoDB ═══════════════
# Estos ids no son secretos: son los de la base actual. Si mueves la base a
# otro NocoDB, cámbialos por los nuevos.

NOCO_TABLE_PRODUCTOS=mayhm5v1psile5b
NOCO_TABLE_STOCK=myy7gc2sxjouy7p
NOCO_TABLE_MOVIMIENTOS=m912u5bxa1xkhx2
NOCO_TABLE_VENTAS=mpesu618t4qc0s2
NOCO_TABLE_PEDIDOS_CLIENTES=m3ic6daz52xc8od
NOCO_TABLE_PEDIDOS_MERCANCIA=mifmctn8yx1xat5
NOCO_TABLE_CLIENTES=m0z12i2x37b08zn
NOCO_TABLE_EQUIPO=mrsvfh6anopw2zd

# Reglas de precio (combos y proporciones). Si falta, el panel funciona igual
# pero esa pantalla avisa que no está configurada.
NOCO_TABLE_PROMOS=mwwyc4tgm81emyn

# Estas dos ya tienen el mismo valor por omisión en el código; solo hace falta
# ponerlas si mueves esas tablas a otro lado.
NOCO_TABLE_PROVEEDORES=m9h0qmsves61a8n
NOCO_TABLE_DEPOSITOS=m1yd40e8ax31pls


# ══ Supabase (identidad y contraseñas) ═══════════════════
# IMPORTANTE: sin estas tres, el servidor cae al login viejo de NocoDB y
# ADEMÁS se desactivan los candados de rol (no puede saber quién es quién, así
# que deja pasar a todos). Es decir: cualquiera con sesión vería Utilidades,
# Proveedores, Depósitos y la IA.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE=


# ══ Opcionales ═══════════════════════════════════════════

# Tianguis IA. Sin esta llave todo el panel funciona normal; lo único que
# falla es la pantalla del chat, y lo dice ahí mismo.
OPENAI_API_KEY=

# Puerto. Muchos servicios lo inyectan solos; si el tuyo lo hace, no la pongas.
PORT=3001

# Huso horario del negocio, para la fecha y la hora de las notas y los
# movimientos. Por omisión America/Merida. Cámbialo solo si el negocio se muda
# de estado, NO si el servidor está en otro país: justamente para eso está.
TZ_NEGOCIO=America/Merida


# ══ Solo si el servidor corre EN la computadora de la caja ══
# Impresora térmica y báscula son hardware local: en un servidor en la nube no
# aplican. Las notas se imprimen igual desde el navegador.

PRINTER_NAME=
BALANZA_PORT=COM3
BALANZA_BAUD=9600


# ══ Solo para scripts, no para el servidor ═══════════════
# scripts/migrar-usuarios-supabase.mjs las usa al dar de alta cuentas.
CLAVE_INICIAL=
